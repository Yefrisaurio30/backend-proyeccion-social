# =============================================================================
# EJEMPLO DE CONFIGURACION (dev) - copiar a .env y ajustar
#   copy .env.example .env
# =============================================================================

SECRET_KEY=cambiar-esta-clave-por-una-segura
DEBUG=True
ALLOWED_HOSTS=*

# Base de datos (PostgreSQL)
DB_NAME=proyeccion_social
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# CORS (origen del frontend en desarrollo)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Almacenamiento de imagenes: local o supabase
IMAGE_STORAGE=local

# Supabase (solo necesario si IMAGE_STORAGE=supabase)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=tu-supabase-key
SUPABASE_BUCKET=publicaciones-images